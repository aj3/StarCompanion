{
  "schema_version": 2,
  "name": "rank-first",
  "description": "Org and difficulty rank lead every title so a flat contract list scans by tier. Rep is emphasised harder than gate notes.",
  "fields": {
    "reputation": true,
    "blueprints": true,
    "scenario_points": true,
    "scrip": true,
    "rank_gates": true,
    "regional_variants": false,
    "caveats": true
  },
  "formatting": {
    "emphasis": "EM4",
    "by_field": {
      "reputation": "EM4",
      "gates": "EM3",
      "regional": "EM3",
      "scrip": "EM3"
    },
    "max_pool_items": 12,
    "title": {
      "bracket_rep": true,
      "bracket_bp": true,
      "prefix": "org_rank"
    }
  },
  "wording": {
    "mode": "structured",
    "section_order": ["reputation", "blueprints", "items", "scrip", "scenario"],
    "labels": {},
    "reputation_separator": " / ",
    "thousands_separator": true
  },
  "templates": {},
  "injection": {
    "mode": "merge",
    "backup": true
  }
}
